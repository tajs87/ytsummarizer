# Azure Deployment Environment Variables
# Copy this to .env.azure and fill in your values

# Azure Configuration
RESOURCE_GROUP=ytsum-rg
LOCATION=westeruope
REGISTRY_NAME=ytsumregistry

# Database
POSTGRES_PASSWORD=admin
DATABASE_URL=postgresql://ytsumadmin:your-password@your-server.postgres.database.azure.com:5432/ytsum

# Redis
REDIS_URL=rediss://:your-redis-key@your-redis.redis.cache.windows.net:6380/0?ssl_cert_reqs=required

# Application Secrets
SECRET_KEY=your-jwt-secret-key-at-least-32-characters
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Optional: Custom Domain
CUSTOM_DOMAIN=yourdomain.com

# Optional: Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here
