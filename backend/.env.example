# Database Configuration
DATABASE_URL=postgresql://ytsum_user:ytsum_password@localhost:5432/ytsum

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
GUEST_SESSION_COOKIE_NAME=ytsum_guest_session
GUEST_SESSION_MAX_AGE_SECONDS=86400
GUEST_SESSION_SECURE_COOKIE=false
GUEST_SESSION_SAME_SITE=lax

# Application Settings
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_VIDEO_DURATION_HOURS=3
RATE_LIMIT_VIDEOS_PER_HOUR=10

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File Storage (optional - for local development)
TEMP_STORAGE_PATH=/tmp/ytsum

# Logging
LOG_LEVEL=INFO
